# Copy this file to .env.e2e.local (repo root) and fill in a real test user
# from the Netlify Identity instance this app points to (VITE_IDENTITY_URL).
# .env.e2e.local is gitignored (matches *.local), never commit real values.

E2E_USER_EMAIL=<E2E_USER_EMAIL>
E2E_USER_PASSWORD=<E2E_USER_PASSWORD>
