{
  "name": "pompom-time",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "Nath Paiva",
  "scripts": {
    "docker:stop": "docker compose -f docker-compose.yml stop",
    "docker": "docker compose -f docker-compose.yml up -d",
    "dev": "yarn docker && ntl dev",
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:serverless": "vitest --config serverless/vite.config.ts --run",
    "test:serverless:watch": "vitest --config serverless/vite.config.ts",
    "test:serverless:ui": "yarn test:serverless:watch --coverage",
    "test:serverless:coverage": "vitest --config serverless/vite.config.ts --coverage --run",
    "test:serverless:ci": "yarn test:serverless:coverage",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "yarn test:watch --coverage",
    "test:coverage": "vitest --coverage --run",
    "test:ci": "yarn test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint:client": "tsc --project tsconfig.json --noEmit && eslint client --ext .ts,.tsx",
    "lint:serverless": "tsc --project tsconfig.json --noEmit && eslint serverless --ext .ts,.tsx",
    "lint": "yarn lint:client && yarn lint:serverless",
    "format:client": "eslint client --ext .js,.jsx,.ts,.tsx --fix",
    "format:serverless": "eslint serverless --ext .js,.jsx,.ts,.tsx --fix",
    "format": "yarn format:client && yarn format:serverless",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.10.10",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@middy/core": "^7.7.2",
    "@middy/http-error-handler": "^7.7.2",
    "@middy/http-json-body-parser": "^7.7.2",
    "@middy/validator": "^7.7.2",
    "@netlify/functions": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "lodash": "^4.18.1",
    "netlify-identity-widget": "^2.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-netlify-identity": "^0.2.7",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/client-preset": "6.1.2",
    "@graphql-codegen/introspection": "6.1.0",
    "@graphql-codegen/near-operation-file-preset": "^5.2.1",
    "@graphql-codegen/typescript-graphql-request": "^7.1.0",
    "@nathpaiva/eslint-config-react": "1.0.14",
    "@nathpaiva/prettier-config": "^1.0.2",
    "@playwright/test": "^1.62.1",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/aws-lambda": "^8.10.162",
    "@types/netlify-identity-widget": "^1.9.7",
    "@types/node": "20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import-helpers": "^2.0.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "framer-motion": "^10.18.0",
    "jsdom": "^27.4.0",
    "netlify-cli": "^19.1.7",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "vitest-fetch-mock": "^0.4.5"
  }
}
